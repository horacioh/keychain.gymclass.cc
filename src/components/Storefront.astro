---
import Site from '../layouts/Site.astro';
import ProductControls from './ProductControls.astro';
import { copy, productDescriptions } from '../config/copy';
import { formatPrice, isBundle, products, type Language } from '../config/products';

interface Props { language: Language }
const { language } = Astro.props;
const t = copy[language];
---
<Site language={language} title={language === 'en' ? 'Your belt, on your keys' : 'Tu cinturón, en tus llaves'} description={t.pitch}>
  <main class="wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">{t.title}</h1>
        <p>{t.pitch}</p>
        <a class="button button-dark" href="#shop">{t.browse} <span aria-hidden="true">↓</span></a>
      </div>
      <img class="hero-image" width="2400" height="1350" src="/lineup.webp" alt={t.photoAlt} fetchpriority="high" />
    </section>

    <section id="shop" class="shop" aria-labelledby="shop-title">
      <div class="section-heading">
        <h2 id="shop-title">{t.shopTitle}</h2>
        <p>{t.shopText}</p>
      </div>
      <div class="shop-grid" data-store
        data-language={language}
        data-pending={t.pending}
        data-checkout={t.checkout}
        data-error={t.checkoutError}
        data-price-changed={t.priceChanged}
      >
        <div class="products">
          {products.map((product) => {
            const bundle = isBundle(product.id);
            const alt = product.id === 'bundle' ? t.bundleAlt : product.id === 'bundle-teacher' ? t.teacherBundleAlt : product.name[language];
            const size = bundle ? 1000 : 1600;
            const dialogId = `details-${product.id}`;
            return (
              <article class="product" data-product={product.id}>
                <button class="product-image product-trigger" type="button" data-open-details aria-haspopup="dialog" aria-controls={dialogId} aria-label={product.name[language]}>
                  <img src={product.image} alt={alt} width={size} height={size} decoding="async" loading="lazy" />
                </button>
                <div class="product-body">
                  <h3><button class="product-trigger" type="button" data-open-details aria-haspopup="dialog" aria-controls={dialogId}>{product.name[language]}</button></h3>
                  {bundle && <p class="bundle-detail">{product.id === 'bundle' ? t.bundleDetail : t.teacherBundleDetail}</p>}
                  <ProductControls product={product} language={language} />
                </div>
                <dialog class="product-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`} aria-describedby={`${dialogId}-description`}>
                  <div class="product-dialog-content">
                    <button class="product-dialog-close" type="button" data-close-details autofocus aria-label={t.closeDetails}>×</button>
                    <img class="product-dialog-image" src={product.image} alt={alt} width={size} height={size} decoding="async" loading="lazy" />
                    <div class="product-dialog-body">
                      <h2 id={`${dialogId}-title`}>{product.name[language]}</h2>
                      <p id={`${dialogId}-description`}>{productDescriptions[language][product.id]}</p>
                      <ProductControls product={product} language={language} />
                    </div>
                  </div>
                </dialog>
              </article>
            );
          })}
        </div>
        <aside class="order" aria-labelledby="order-title">
          <div class="cart">
            <h2 id="order-title">{t.cartTitle}</h2>
            <p class="cart-empty" data-empty>{t.empty}</p>
            <ul class="cart-items" data-cart-items hidden></ul>
            <div class="cart-total flex items-center justify-between gap-4">
              <span>{t.total}</span>
              <output data-total aria-live="polite">{formatPrice(0, language)}</output>
            </div>
            <button class="button button-dark checkout" type="button" data-checkout-button disabled>
              <span data-checkout-label>{t.checkout}</span><span aria-hidden="true">↗</span>
            </button>
            <p class="checkout-error" data-checkout-error role="alert" hidden></p>
            <p class="cart-charge">{t.charge}</p>
          </div>
          <div class="delivery">
            <h3>{t.deliveryTitle}</h3>
            <p>{t.delivery}</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="faq" class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{t.faqTitle}</h2>
      <div class="faq-list">
        {t.faq.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}<span aria-hidden="true">+</span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</Site>

<script>
  import { formatPrice, getCompareAtPrice, getFallbackPrice, MAX_QUANTITY, products, type Language, type ProductId } from '../config/products';

  const store = document.querySelector<HTMLElement>('[data-store]')!;
  const language = store.dataset.language as Language;
  const checkout = store.querySelector<HTMLButtonElement>('[data-checkout-button]')!;
  const label = store.querySelector<HTMLElement>('[data-checkout-label]')!;
  const error = store.querySelector<HTMLElement>('[data-checkout-error]')!;
  const empty = store.querySelector<HTMLElement>('[data-empty]')!;
  const list = store.querySelector<HTMLUListElement>('[data-cart-items]')!;
  const total = store.querySelector<HTMLOutputElement>('[data-total]')!;
  const storageKey = 'bjj-keychain-cart';
  const cart = new Map<ProductId, number>();
  const prices = new Map<ProductId, number>();
  const priceFor = (id: ProductId) => prices.get(id) ?? getFallbackPrice(id);

  function updatePrices(values: unknown, preserveExisting = false) {
    if (!values || typeof values !== 'object') return;
    for (const { id } of products) {
      if (preserveExisting && prices.has(id)) continue;
      const amount = (values as Record<string, unknown>)[id];
      if (typeof amount === 'number' && Number.isSafeInteger(amount) && amount >= 0) prices.set(id, amount);
    }
  }

  try {
    const saved: Record<string, unknown> | null = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null');
    for (const { id } of products) {
      const qty = saved?.[id];
      if (typeof qty === 'number' && Number.isInteger(qty) && qty > 0 && qty <= MAX_QUANTITY) cart.set(id, qty);
    }
  } catch {
    // A blocked or stale session store must not prevent ordering.
  }

  const cards = products.map(product => {
    const card = store.querySelector<HTMLElement>(`[data-product="${product.id}"]`)!;
    const dialog = card.querySelector('dialog')!;
    let opener: HTMLButtonElement | undefined;
    for (const trigger of card.querySelectorAll<HTMLButtonElement>('[data-open-details]')) {
      trigger.addEventListener('click', () => {
        opener = trigger;
        dialog.showModal();
      });
    }
    dialog.querySelector('[data-close-details]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      if (!dialog.open) opener?.focus({ preventScroll: true });
    });
    let backdropPressed = false;
    dialog.addEventListener('pointerdown', event => { backdropPressed = event.target === dialog; });
    dialog.addEventListener('click', event => {
      if (backdropPressed && event.target === dialog) dialog.close();
    });
    return {
      product,
      controls: Array.from(card.querySelectorAll('[data-product-controls]'), controls => ({
        unitPrice: controls.querySelector<HTMLElement>('[data-unit-price]')!,
        compareAt: controls.querySelector<HTMLElement>('[data-compare-at]'),
        decrement: controls.querySelector<HTMLButtonElement>('[data-step="-1"]')!,
        increment: controls.querySelector<HTMLButtonElement>('[data-step="1"]')!,
        quantity: controls.querySelector<HTMLOutputElement>('[data-quantity]')!,
      })),
    };
  });

  let pending = false;
  function render() {
    let amount = 0;
    list.replaceChildren();
    for (const { product, controls } of cards) {
      const qty = cart.get(product.id) ?? 0;
      const cents = priceFor(product.id);
      for (const { unitPrice, compareAt, decrement, increment, quantity } of controls) {
        unitPrice.textContent = formatPrice(cents, language);
        if (compareAt) {
          const separate = getCompareAtPrice(product.id, priceFor);
          compareAt.hidden = separate === null;
          compareAt.querySelector('del')!.textContent = separate === null ? '' : formatPrice(separate, language);
        }
        quantity.value = String(qty);
        decrement.disabled = pending || qty === 0;
        increment.disabled = pending || qty === MAX_QUANTITY;
      }
      if (!qty) continue;
      const line = document.createElement('li');
      const productLabel = document.createElement('span');
      productLabel.textContent = `${qty} × ${product.name[language]}`;
      const price = document.createElement('span');
      price.textContent = formatPrice(qty * cents, language);
      line.append(productLabel, price);
      list.append(line);
      amount += qty * cents;
    }
    empty.hidden = cart.size > 0;
    list.hidden = cart.size === 0;
    total.value = formatPrice(amount, language);
    checkout.disabled = pending || !cart.size;
    label.textContent = (pending ? store.dataset.pending : store.dataset.checkout) ?? '';
  }

  function change(id: ProductId, delta: number) {
    const qty = (cart.get(id) ?? 0) + delta;
    if (qty < 0 || qty > MAX_QUANTITY) return;
    if (qty) cart.set(id, qty);
    else cart.delete(id);
    try {
      sessionStorage.setItem(storageKey, JSON.stringify(Object.fromEntries(cart)));
    } catch {
      // The current page can still keep the order in memory.
    }
    error.hidden = true;
    render();
  }

  for (const { product, controls } of cards) {
    for (const { decrement, increment } of controls) {
      decrement.addEventListener('click', () => change(product.id, -1));
      increment.addEventListener('click', () => change(product.id, 1));
    }
  }

  checkout.addEventListener('click', async () => {
    if (pending || !cart.size) return;
    pending = true;
    error.hidden = true;
    render();
    try {
      const response = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: products.flatMap(({ id }) => {
            const qty = cart.get(id);
            return qty ? [{ id, qty, unitAmount: priceFor(id) }] : [];
          }),
        }),
      });
      if (response.status === 409) {
        const { prices: current } = await response.json();
        updatePrices(current);
        error.textContent = store.dataset.priceChanged ?? '';
        error.hidden = false;
        pending = false;
        render();
        return;
      }
      if (!response.ok) throw new Error('Checkout request failed');
      const { url } = await response.json();
      if (typeof url !== 'string') throw new Error('Missing checkout URL');
      window.location.assign(url);
    } catch {
      error.textContent = store.dataset.error ?? '';
      error.hidden = false;
      pending = false;
      render();
    }
  });

  window.addEventListener('pageshow', (event) => {
    if (event.persisted) { pending = false; render(); }
  });
  render();

  async function loadPrices() {
    try {
      const response = await fetch('/api/prices');
      if (!response.ok) return;
      const values: unknown = await response.json();
      updatePrices(values, true);
      render();
    } catch {
      // Keep the static prices if the catalog is unavailable.
    }
  }
  void loadPrices();
</script>
